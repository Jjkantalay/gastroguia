# База данных.
# Для разработки — встроенный PostgreSQL (PGlite) в папке .pglite, ничего устанавливать не нужно:
DATABASE_URL=pglite:./.pglite
# Обычный PostgreSQL с pgvector (например, docker compose up -d db):
# DATABASE_URL=postgres://gastroguia:gastroguia@localhost:5432/gastroguia

# Ключ Claude API для ассистента (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Модель ассистента (необязательно)
ANTHROPIC_MODEL=claude-opus-5-5
